PORT=4312
APP_URL=http://localhost:4311

AI_PROVIDER_ORDER=groq,gemini,openrouter,ollama,ai-gateway,openai

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# No API key needed — resilience fallback for when free-tier rate limits
# are exhausted, sits before any paid option. Set OLLAMA_DIAGNOSIS_ENABLED=false
# to skip it (e.g. if the fleet node is down for an extended period).
OLLAMA_DIAGNOSIS_URL=http://100.72.213.92:11435
OLLAMA_DIAGNOSIS_MODEL=qwen2.5:7b
OLLAMA_DIAGNOSIS_ENABLED=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

AI_GATEWAY_MODEL=openai/gpt-5.4

DATABASE_URL=
AUTH_SECRET=replace-with-at-least-32-random-characters

# Quote delivery (optional — simulates to console if not set)
RESEND_API_KEY=
RESEND_FROM_EMAIL=repairscout@whitegwireless.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe (required for paid diagnosis)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DIAGNOSIS_PRICE_CENTS=999

# Bland.ai (required for AI parts verification calls)
BLAND_API_KEY=
BLAND_VOICE_ID_EN=a1f0ca64-75a7-4955-a42e-32470479e81e
BLAND_VOICE_ID_ES=a5cf9d28-82b5-463c-9916-50b75d074dd1
