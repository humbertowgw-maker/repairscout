{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-tracking",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/nudge-outcome-surveys",
      "schedule": "0 16 * * *"
    }
  ]
}
